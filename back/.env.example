PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/singles-plans
JWT_SECRET=replace-this-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:4200
API_ORIGIN=http://localhost:3000
TURNSTILE_SECRET_KEY=replace-with-the-turnstile-secret-key
# OAuth. OAUTH_DEMO=1 muestra una pantalla local de prueba en lugar de contactar
# con el proveedor; úsalo solo en desarrollo y ponlo a 0 al configurar credenciales reales.
OAUTH_DEMO=0
# Por defecto la URI de retorno se calcula desde API_ORIGIN:
#   http://localhost:3000/api/auth/oauth/<proveedor>/callback
# Google y Facebook admiten esa URL en local. Apple exige HTTPS y un dominio público,
# así que en local usa un túnel y define APPLE_REDIRECT_URI con esa URL pública.
# GOOGLE_REDIRECT_URI=
# FACEBOOK_REDIRECT_URI=
# APPLE_REDIRECT_URI=https://tu-tunnel/api/auth/oauth/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Configura SMTP para enviar los correos de recuperación. Sin estos valores,
# /api/auth/password/forgot responde 503 y no envía instrucciones.
# Resend: SMTP_PASSWORD es la API key (re_...). En local, onboarding@resend.dev
# solo envía al correo de la cuenta de Resend; en producción usa un dominio verificado.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
